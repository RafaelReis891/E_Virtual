#!/usr/bin/env python3
"""Servidor local para testar o build Unity WebGL (pasta onde este arquivo esta).
- Content-Type correto para .wasm, .js, .data
- Se existirem arquivos .br / .gz / .unityweb: Content-Encoding + Content-Type do arquivo original
- Suporte a Range (necessario para videos .mp4 no Unity)
- Cache desligado (sempre pega a build mais nova)
Uso: py servidor_local.py [porta]
"""
import os, sys, re, mimetypes
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

ROOT = os.path.dirname(os.path.abspath(__file__))
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8000

TYPES = {
    ".wasm": "application/wasm", ".js": "application/javascript", ".json": "application/json",
    ".data": "application/octet-stream", ".mp4": "video/mp4", ".webmanifest": "application/manifest+json",
    ".html": "text/html; charset=utf-8", ".css": "text/css", ".png": "image/png",
    ".jpg": "image/jpeg", ".ico": "image/x-icon",
}
ENCODINGS = {".br": "br", ".gz": "gzip"}


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=ROOT, **kw)

    def _inner_type(self, path):
        base, ext = os.path.splitext(path)
        enc = None
        if ext.lower() in ENCODINGS:
            enc = ENCODINGS[ext.lower()]
            path = base
            ext = os.path.splitext(path)[1]
        ctype = TYPES.get(ext.lower()) or mimetypes.guess_type(path)[0] or "application/octet-stream"
        return ctype, enc

    def send_head(self):
        path = self.translate_path(self.path)
        if os.path.isdir(path) or not os.path.isfile(path):
            return super().send_head()
        ctype, enc = self._inner_type(path)
        try:
            f = open(path, "rb")
        except OSError:
            self.send_error(404, "File not found")
            return None
        size = os.fstat(f.fileno()).st_size
        start, end, code = 0, size - 1, 200
        rng = self.headers.get("Range")
        if rng:
            m = re.match(r"bytes=(\d*)-(\d*)$", rng.strip())
            if m and (m.group(1) or m.group(2)):
                if m.group(1):
                    start = int(m.group(1))
                    if m.group(2):
                        end = min(int(m.group(2)), size - 1)
                else:
                    start = max(0, size - int(m.group(2)))
                if start > end or start >= size:
                    f.close()
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % size)
                    self.end_headers()
                    return None
                code = 206
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        if enc:
            self.send_header("Content-Encoding", enc)
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        if code == 206:
            self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        f.seek(start)
        self._remaining = end - start + 1
        return f

    def copyfile(self, source, outputfile):
        remaining = getattr(self, "_remaining", None)
        try:
            while remaining is None or remaining > 0:
                chunk = source.read(min(1024 * 1024, remaining) if remaining is not None else 1024 * 1024)
                if not chunk:
                    break
                outputfile.write(chunk)
                if remaining is not None:
                    remaining -= len(chunk)
        except (ConnectionResetError, BrokenPipeError, ConnectionAbortedError):
            pass

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))


if __name__ == "__main__":
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print("Servindo %s em http://localhost:%d/  (Ctrl+C para parar)" % (ROOT, PORT))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass